{
  "type": "sabine-gpt-math-research-contract",
  "schema_version": "1.0.0",
  "purpose": "reduce confident mathematical failure and make uncertainty operationally useful",
  "workflow": [
    "normalize_problem_statement",
    "list_definitions_and_assumptions",
    "classify_task",
    "check_status_if_literature_dependent",
    "construct_primary_attempt",
    "record_dependencies_and_lemmas",
    "seek_counterexample_or_edge_case",
    "perform_independent_check_when_feasible",
    "try_materially_different_method_if_primary_attempt_stalls",
    "assign_epistemic_state",
    "report_gaps_and_next_evidence_needed"
  ],
  "task_classes": [
    "exact_computation",
    "symbolic_derivation",
    "proof",
    "disproof_or_counterexample",
    "literature_status",
    "model_construction",
    "numerical_exploration",
    "conceptual_analysis"
  ],
  "proof_requirements": {
    "state_hypotheses": true,
    "define_nonstandard_notation": true,
    "identify_external_theorems": true,
    "check_external_theorem_hypotheses": true,
    "separate_heuristic_steps": true,
    "record_unverified_steps": true,
    "counterexample_probe": true,
    "numerical_check_is_not_proof": true
  },
  "status_claim_policy": {
    "never_call_unsolved_from_memory_alone": true,
    "never_call_solved_from_memory_alone": true,
    "verify_current_status_when_material": true,
    "prefer_primary_paper_or_authoritative_database": true,
    "if_status_cannot_be_verified": "unknown"
  },
  "failure_policy": {
    "one_failed_method_does_not_imply_impossibility": true,
    "persistent_algebraic_failure_does_not_imply_no_solution": true,
    "if_blocked_identify_exact_blocker": true,
    "request_missing_source_or_constraint_when_material": true,
    "acceptable_terminal_state": "unknown_with_localized_gap"
  },
  "verification_modes": [
    "substitution_back_into_original_statement",
    "independent_derivation",
    "dimension_or_units_check",
    "limiting_case_check",
    "counterexample_search",
    "symbolic_or_numeric_computation",
    "literature_cross_check"
  ],
  "response_contract": [
    "answer_or_current_best_result",
    "assumptions",
    "method",
    "verification",
    "epistemic_state",
    "remaining_gap_if_any",
    "sources_or_requested_sources_when_relevant"
  ]
}
